---
interface Props {
  title: string;
  date: Date;
  updated?: Date;
}

const { title, date, updated } = Astro.props;
---

<header>
  <h1 class="title" itemprop="name headline">{title}</h1>
  {/* 可见的发布/更新日期与字数、时长显示在封面（Brand），这里仅保留 microdata */}
  <meta itemprop="dateCreated datePublished" content={date.toISOString()} />
  <meta itemprop="dateModified" content={(updated ?? date).toISOString()} />
</header>
