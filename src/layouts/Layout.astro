---
import NavBar from "@/components/navbar/NavBar";
import Brand from "@/components/Brand.astro";
import HeaderCover from "@/components/HeaderCover.astro";
import Waves from "@/components/Waves.astro";
import { getCollection } from "astro:content";
import type {
  TocItem,
  RelatedPost,
  QuickNavigation,
} from "@/components/sidebar/SidebarTypes";
import "@/styles/view-transition.css";
import "@vtbag/element-crossing?url";

import themeConfig from "@/theme.config.ts";

import "@/styles/palette.css";
import "@/styles/style.css";
import "@/styles/navbar.css";
import "@/styles/sidebar.css";
import "@/styles/widgets.css";
import "@/styles/category-card.css";
import "@/styles/floating-toolbar.css";
import "@/styles/about-dialog.css";
import "@/styles/search-page.css";
import "@/styles/articles-charts.css";
import "@/styles/image-zoom.css";
import "@/styles/header-cover.css";
import "@/styles/code-block-light.css";
import "@/styles/mdx-components.css";

import Loading from "@/components/Loading.astro";
import { covers, resolveFixedCover , coverPresets} from "@/components/Images.astro";
import FloatingToolbar from "@/components/FloatingToolbar";
import TwoColumnLayout from "@/layouts/TwoColumnLayout.astro";
import ThreeColumnLayout from "@/layouts/ThreeColumnLayout.astro";
import { generateTagCloud } from "@/toolkit/posts/generateTagCloud";
import { createWidgetPosts } from "@/toolkit/posts/createWidgetPosts";
import { toTagHref } from "@/toolkit/posts/url";
import { resolveHeaderCovers } from "@/toolkit/headerCover";
import Footer from "@/components/footer/Footer.astro";
import type { ImageMetadata } from "astro";
import { currentLocale } from "@/i18n";
import { css as huninnCss, fontFamilyFallback } from "@/assets/fonts/jf-openhuninn-2.1.ttf?subsets";
import { css as mapleCss } from "@/assets/fonts/MapleMono-CN-Regular.ttf?subsets";
import { buildFontStacks } from "@/toolkit/fontStack";

/**
 * 字体名由 vite-plugin-font 在构建期从字体文件里读出来（jf-openhuninn-2.1、
 * Maple Mono CN），metric 对齐字体名还带构建期 hash —— 都不能写死在 CSS 里，
 * 否则插件或字体文件一改就静默失效。
 */
const fontStacks = buildFontStacks({
  locale: currentLocale,
  primaryFamily: huninnCss.family,
  monoFamily: mapleCss.family,
  metricFallback: fontFamilyFallback,
});

/**
 * 必须以 is:inline 直接进 <head>：字体堆叠要在解析阶段就出现在 CSS 里，
 * 浏览器才会尽早发起 woff2 请求。旧实现是在 DOMContentLoaded 时用 JS 写
 * body.style.fontFamily，实测线上首个 woff2 要到 2425ms 才开始下载
 *（DOMContentLoaded 是 1224ms），配上 font-display: optional 必然错过时机，
 * 表现就是「首访没字体、二访才有」。
 *
 * --shokax-font / --shokax-mono 供其余样式消费。
 *
 * 变数名不能用 --pf-*：那是 Pagefind 的命名空间（--pf-background、--pf-border…，
 * 其中就有 --pf-font）。pagefind-component-ui 的 CSS 以 <link> 载入，排在这段
 * inline style 之后，会把 :root 上的 --pf-font 覆写成它自己的系统字堆叠，
 * 整站字体就静默退回系统字。
 *
 * 也不要再写「读回 --shokax-font 再塞进 body.style」的脚本：inline style 胜过
 * 一切，一旦变数被别人覆写，那段脚本就是把污染值固化到 body 上的注入点。
 * body 的 font-family 由下面这条规则直接给字面堆叠即可。
 */
/**
 * 网站图示。
 *
 * 原本这里写死 <link rel="icon" type="image/svg+xml" href="/favicon.svg">，
 * 但 repo 里从来没有 public/favicon.svg——main、dev、cloudflare 三个分支都没有。
 * 于是每一页都多一个 404，Lighthouse 的 errors-in-console 常态失败。这个 404
 * 早就有人知道：package.json 的 check-links 专门带了 --exclude favicon.svg。
 *
 * 改成由 theme.config 的 icons 指定。预设指向 public/favicon.svg（主题自附）。
 *
 * 注意「不输出 <link> 就没事」是错的：没有 <link> 时浏览器会隐式去要
 * /favicon.ico，那个 404 一样会进 console——实测 dev-v2 拿掉 link 之后
 * best-practices 仍停在 96，errors-in-console 抓的就是这个隐式请求。
 * 所以要免掉 404，必须真的指向一个存在的档案。
 *
 * 站点有自己的图示就在 theme.config.ts 的 icons 覆写（本站指回 favicon.ico）。
 */
const ICON_MIME: Record<string, string> = {
  ".svg": "image/svg+xml",
  ".ico": "image/x-icon",
  ".png": "image/png",
  ".webp": "image/webp",
};
const iconsConfig = themeConfig.icons ?? {};
const faviconHref = iconsConfig.favicon;
const faviconType = faviconHref
  ? ICON_MIME[faviconHref.slice(faviconHref.lastIndexOf(".")).toLowerCase()]
  : undefined;
const appleTouchIconHref = iconsConfig.appleTouchIcon;

// 播放器是否启用：与 hyacine.plugin.ts 的 gate 同一个来源
const nyxPlayerEnabled = themeConfig.plugins?.nyxPlayer?.enable === true;

const criticalFontCss = [
  `:root{--shokax-font:${fontStacks.body};--shokax-mono:${fontStacks.mono}}`,
  `body{font-family:${fontStacks.body}}`,
].join("");

// Accept sidebar props from child pages
interface PostMeta {
  date: Date;
  wordCount: number;
  readTime: number;
}

interface Props {
  toc?: TocItem[];
  relatedPosts?: RelatedPost[];
  currentSlug?: string;
  navigation?: QuickNavigation;
  pageTitle?: string;
  postMeta?: PostMeta;
  indexPage?: boolean;
  pageCover?: ImageMetadata | string;
}

const {
  toc = [],
  relatedPosts = [],
  currentSlug = "",
  navigation = {},
  pageTitle = "",
  postMeta,
  indexPage = false,
  pageCover,
} = Astro.props;

const navLinks = themeConfig.nav;
const siteName = themeConfig.siteName;
const sidebarConfig = themeConfig.sidebar || {};
const brandConfig = themeConfig.brand || {};
const coverConfig = themeConfig.cover || {};
const footerConfig = themeConfig.footer || {};
const widgetsConfig = themeConfig.widgets || {};
const tagCloudConfig = themeConfig.tagCloud || {};
const layoutConfig = themeConfig.layout || {};
const rightSidebarConfig = layoutConfig.rightSidebar || {};
const layoutMode = layoutConfig.mode || "two-column";
const enableThirdColumn = layoutMode === "three-column";
const shouldComputeRightSidebarRandomPosts =
  enableThirdColumn && rightSidebarConfig.randomPosts === true;
const shouldComputeRightSidebarRecentMoments =
  enableThirdColumn && rightSidebarConfig.recentMoments === true;
const shouldComputeRightSidebarTagCloud =
  enableThirdColumn && rightSidebarConfig.tagCloud === true;
const ActiveLayout = enableThirdColumn ? ThreeColumnLayout : TwoColumnLayout;

// fixedCover：通过 Images.astro 统一解析（静态导入走 <Image />，字符串走 <img> 兜底）
const fixedCover = coverConfig.fixedCover?.enable
  ? resolveFixedCover(coverConfig.fixedCover.url)
  : undefined;
const advancedCarousel = coverConfig.advancedCarousel === true;
const headerCovers = advancedCarousel
  ? await resolveHeaderCovers({
      coverUrls: coverConfig.coverUrls,
      fallbackCovers: covers,
      presets: coverPresets,
    })
  : [];
const resolvedHeaderCover = pageCover ?? fixedCover;

// Get all posts for widgets
const allPosts = await getCollection("posts");
const posts = allPosts.filter((post) => !post.data.draft);
const moments = shouldComputeRightSidebarRecentMoments
  ? (await getCollection("moments")).toSorted(
      (a, b) =>
        new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
    )
  : [];
const rightSidebarPosts = shouldComputeRightSidebarRandomPosts
  ? posts.filter((post) => !post.data.encrypted)
  : [];
const rightSidebarTagCloud = shouldComputeRightSidebarTagCloud
  ? (() => {
      const rightSidebarTagCounts = posts.reduce((acc, post) => {
        post.data.tags?.forEach((tag) => {
          acc.set(tag, (acc.get(tag) || 0) + 1);
        });

        return acc;
      }, new Map<string, number>());

      return generateTagCloud(
        Array.from(rightSidebarTagCounts.entries()).map(([name, count]) => ({
          name,
          count,
        })),
        {
          minFontSize: 12,
          maxFontSize: 20,
          startColor: tagCloudConfig.startColor,
          endColor: tagCloudConfig.endColor,
          limit: 16,
        },
      ).map((tag) => ({
        name: tag.name,
        count: tag.count,
        fontSize: tag.fontSize,
        color: tag.color,
        href: toTagHref(tag.name),
      }));
    })()
  : [];

const siteState = {
  categories: allPosts.reduce((acc, post) => {
    post.data.categories?.forEach((category) => acc.add(category));
    return acc;
  }, new Set()).size,
  posts: posts.length,
  tags: allPosts.reduce((acc, post) => {
    post.data.tags?.forEach((tag) => acc.add(tag));
    return acc;
  }, new Set()).size,
};

const widgetPosts = createWidgetPosts(posts);

// Import custom elements definitions
import CodeBlock from "@/components/CodeBlock";
import MermaidDiagram from "@/components/MermaidDiagram";
import ImageZoom from "@/components/ImageZoom";
import SearchPage from "@/components/search/SearchPage";
import HyacineOutlet from "@hyacine/plugin-astro/components/HyacineOutlet.astro";
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {faviconHref && <link rel="icon" type={faviconType} href={faviconHref} />}
    {appleTouchIconHref && <link rel="apple-touch-icon" href={appleTouchIconHref} />}
    <meta name="generator" content={Astro.generator} />
    <style is:inline set:html={criticalFontCss} />
    {
      Astro.site && (
        <link
          rel="canonical"
          href={new URL(Astro.url.pathname, Astro.site).toString()}
        />
      )
    }

    <script>
      import "virtual:hyacine/runtime";
    </script>

    <slot name="head" />

    <meta http-equiv="X-Content-Type-Options" content="nosniff" />

    <title>{pageTitle}</title>
  </head>
  <body data-layout-mode={layoutMode}>
    <NavBar
      client:load
      name={siteName}
      navLinks={navLinks}
      clickToggleCallback={() => void 0}
    />
    <SearchPage client:idle selector="#search" />
    <Loading />
    <div id="container">
      <HeaderCover
        enable={coverConfig.enable}
        preload={coverConfig.preload}
        fixedCover={resolvedHeaderCover}
        gradient={coverConfig.gradient}
        covers={advancedCarousel ? headerCovers : covers}
        advancedCarousel={advancedCarousel}
        title={brandConfig.title}
      />
      <Brand
        title={brandConfig.title}
        subtitle={brandConfig.subtitle}
        logo={brandConfig.logo}
        pageTitle={indexPage ? "" : pageTitle}
        postMeta={postMeta}
      />
      <Waves />
      <main>
        <ActiveLayout
          widgetPosts={widgetPosts}
          widgetsConfig={widgetsConfig}
          sidebarConfig={sidebarConfig}
          rightSidebarConfig={rightSidebarConfig}
          rightSidebarPosts={rightSidebarPosts}
          rightSidebarMoments={moments}
          rightSidebarTagCloud={rightSidebarTagCloud}
          navLinks={navLinks}
          toc={toc}
          relatedPosts={relatedPosts}
          currentSlug={currentSlug}
          navigation={navigation}
          siteState={siteState}
        >
          <slot />
        </ActiveLayout>
      </main>
      <Footer config={footerConfig} {siteName} author={sidebarConfig.author || ""} />
    </div>
    <script>
      import "@/toolkit/initMdxComponents";
    </script>
    <div class="hidden">
      <CodeBlock client:idle />
      <MermaidDiagram client:idle />
      <ImageZoom client:idle />
    </div>
    {/* 写死 true 会让 SSR 一定渲出播放器按钮，插件关掉时得等 hydrate 后才被
        侦测改掉——闪一下，没 hydrate 就一直留着两颗按不动的按钮。 */}
    <FloatingToolbar client:idle hasNyxPlayer={nyxPlayerEnabled} />
    <HyacineOutlet name="layout-bottom" />
  </body>
</html>

<style>
  body {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }
</style>
