---
import { getCollection } from "astro:content";

import ContentDetail from "@/components/post/ContentDetail.astro";
import { filterPublishableGeneralArticles } from "@/toolkit/posts/content";
import { createPostContentContainer } from "@/toolkit/posts/createPostContentContainer";
import { prepareContentDetail } from "@/toolkit/posts/prepareContentDetail";
import { comparePostsByOrderDateDesc } from "@/toolkit/posts/sortPosts";

export async function getStaticPaths() {
  // /posts/ 只收公开一般文章：静态路径、上下篇与相关文章共用这一个数组，
  // 工具不会出现在其中任何一处
  const posts = await getCollection("posts");
  const sortedPosts = filterPublishableGeneralArticles(posts).toSorted(comparePostsByOrderDateDesc);

  const container = await createPostContentContainer();

  return Promise.all(
    sortedPosts.map(async (post, index) => {
      const prevPost = index > 0 ? sortedPosts[index - 1] : undefined;
      const nextPost = index < sortedPosts.length - 1 ? sortedPosts[index + 1] : undefined;

      // Get related posts from the same category
      const categories = post.data.categories || [];
      const relatedPosts =
        categories.length > 0
          ? sortedPosts
              .filter(
                (p) => p.id !== post.id && p.data.categories?.some((c) => categories.includes(c)),
              )
              .slice(0, 10)
              .map((p) => ({
                slug: p.id,
                title: p.data.title,
                date: p.data.date,
                category: p.data.categories?.[0],
              }))
          : [];

      const prepared = await prepareContentDetail(post, {
        container,
        siteUrl: import.meta.env.SITE,
      });

      return {
        params: { slug: post.id },
        props: {
          post,
          prevPost: prevPost
            ? {
                title: prevPost.data.title,
                slug: prevPost.id,
                category: prevPost.data.categories?.[0],
                cover:
                  typeof prevPost.data.cover === "string"
                    ? prevPost.data.cover
                    : prevPost.data.cover?.src,
              }
            : undefined,
          nextPost: nextPost
            ? {
                title: nextPost.data.title,
                slug: nextPost.id,
                category: nextPost.data.categories?.[0],
                cover:
                  typeof nextPost.data.cover === "string"
                    ? nextPost.data.cover
                    : nextPost.data.cover?.src,
              }
            : undefined,
          relatedPosts,
          ...prepared,
        },
      };
    }),
  );
}

const { post, ...detail } = Astro.props;
---

<ContentDetail entry={post} {...detail} />
